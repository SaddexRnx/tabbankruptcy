{
  "manifest_version": 3,
  "name": "TabBankruptcy",
  "version": "1.0.0",
  "description": "Hoarding tabs? Declare bankruptcy. Save every open tab into a named session, close them all, and free up RAM in one click.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "index.html",
    "default_title": "TabBankruptcy",
    "default_icon": "icon.png"
  },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
